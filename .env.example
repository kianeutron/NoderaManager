# Server-only Lakebase Postgres connection string from Neon.
DATABASE_URL=
# One allowlisted owner email. This is enforced by every application boundary.
OWNER_EMAIL=owner@example.com
# Better Auth values are server-only. Generate the secret with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Public application URL (no secret values belong in NEXT_PUBLIC_* variables).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google OAuth credentials for dashboard sign-in and MCP authorization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Private Vercel Blob store used for library files. Server-only; never expose it to the browser.
BLOB_READ_WRITE_TOKEN=
