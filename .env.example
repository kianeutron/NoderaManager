# Server-only Lakebase Postgres connection string from Neon.
DATABASE_URL=
# One allowlisted owner email. This is enforced by every application boundary.
OWNER_EMAIL=owner@example.com
# Neon Auth values are server-only. Generate the cookie secret with `openssl rand -base64 48`.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Public application URL (no secret values belong in NEXT_PUBLIC_* variables).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# A separately configured OAuth authorization server for the remote MCP endpoint.
# The endpoint fails closed until all of these are set.
MCP_AUTHORIZATION_SERVER=
MCP_JWKS_URL=
MCP_ISSUER=
MCP_AUDIENCE=
# Private Vercel Blob store used for library files. Server-only; never expose it to the browser.
BLOB_READ_WRITE_TOKEN=
